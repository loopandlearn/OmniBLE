    "You will now begin the process of configuring your reminders, filling your Pod with insulin, pairing to your device and placing it on your body." : {
      "comment" : "bodyText for PodSetupView",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستبدأ الآن عملية إعداد التذكيرات الخاصة بك، وملء البود بالإنسولين، وإقرانه بجهازك، ثم تثبيته على جسمك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skal nu begynde at konfigurere dine påmindelser, fylde din Pod med insulin, parre den med din enhed og placere den på din krop."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im nächsten Schritt wirst du deine Erinnerungen konfigurieren, deinen Pod mit Insulin füllen, ihn mit deinem Gerät koppeln und an deinem Körper anbringen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora comenzará el proceso de configurar sus recordatorios, llenar su Pod con insulina, emparejarlo con su dispositivo y colocárselo en el cuerpo."
          }
        },
        "fi" : {
