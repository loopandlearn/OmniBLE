      }
    },
    "There was a problem communicating with the pod. If this problem persists, tap Discard Pod. You can then activate a new Pod." : {
      "comment" : "Format string for recovery suggestion during deactivate pod.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كانت هناك مشكلة في التواصل مع البود. إذا استمرت هذه المشكلة، انقر على \"تجاهل البود\". يمكنك بعد ذلك تفعيل بود جديد."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke kommunikere med Pod'en. Hvis problemet fortsætter, tryk Afbryd og kassér Pod'en. Du kan herefter aktivere en ny Pod."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gab ein Problem bei der Kommunikation mit dem Pod. Wenn dieses Problem weiterhin besteht, tippe auf \"Pod verwerfen\". Du kannst dann einen neuen Pod aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha producido un problema de comunicación con el Pod. Si el problema persiste, pulse Descartar Pod. A continuación, puede activar un nuevo Pod."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There was a problem communicating with the pod. If this problem persists, tap Discard Pod. You can then activate a new Pod."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a eu un problème de communication avec le Pod. Si ce problème persiste, appuyez sur Jeter le pod. Vous pourrez ensuite activer un nouveau Pod."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There was a problem communicating with the pod. If this problem persists, tap Discard Pod. You can then activate a new Pod."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There was a problem communicating with the pod. If this problem persists, tap Discard Pod. You can then activate a new Pod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è verificato un problema di comunicazione con il pod. Se questo problema persiste, premi Scarta pod. Poi puoi attivare un nuovo pod."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det var kommunikasjonsproblemer med pod. Om problemet vedvarer, trykk Forkast pod. Du kan deretter aktivere en ny pod."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er was een communicatieprobleem met de Pod. Als dit probleem zich blijft voordoen, tik dan op 'Pod verwijderen'. Je kunt dan een nieuwe Pod activeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There was a problem communicating with the pod. If this problem persists, tap Discard Pod. You can then activate a new Pod."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There was a problem communicating with the pod. If this problem persists, tap Discard Pod. You can then activate a new Pod."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There was a problem communicating with the pod. If this problem persists, tap Discard Pod. You can then activate a new Pod."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возникла проблема связи с Подом. Если эта проблема сохраняется, нажмите Отменить Под. Затем, Вы можете активировать новый."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyskytol sa problém pri komunikácii s Podom. Ak problém pretrváva, klepnite na Zahodiť Pod. Potom môžete aktivovať nový Pod."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att kommunicera med podden. Om problemet kvarstår, tryck på 'Kasta Pod'. Du kan sedan aktivera en ny podd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod ile iletişimde bir sorun oluştu. Bu sorun devam ederse, Pod'u At'a tıklayın. Ardından yeni bir Pod etkinleştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виникла проблема зв’язку з Podʼом. Якщо проблема не зникає, торкніться «Відхилити Pod». Потім ви можете активувати новий Pod."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xảy ra sự cố khi giao tiếp với Pod. Nếu sự cố này vẫn tiếp diễn, hãy nhấn vào Loại bỏ pod. Sau đó, bạn có thể kích hoạt Pod mới."
          }
        },
        "yy-YY" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There was a problem communicating with the pod. If this problem persists, tap Discard Pod. You can then activate a new Pod."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与Pod通讯时出现问题。如果这个问题无法解决，请弃用此Pod，并激活一个新Pod。"
          }
        }
      }
    },
    "This PumpManager has not been configured with a maximum basal rate because it was added before manual temp basal was a feature. Please set a new maximum basal rate." : {
