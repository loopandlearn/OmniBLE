    "Remove blue Pod needle cap and check cannula. Then remove paper backing." : {
      "comment" : "Label text for step two of attach pod instructions",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove blue Pod needle cap and check cannula. Then remove paper backing."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern den blå Pod-nålehætte, og kontrollér kanylen. Fjern derefter papiret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernte die blaue Kappe und überprüfe die Kanüle. Dann entferne das Papier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire la tapa azul de la aguja del Pod y revise la cánula. A continuación, retire el cobertor de papel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove blue Pod needle cap and check cannula. Then remove paper backing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirez la languette bleu du pod et vérifiez la canule. Retirez ensuite le film en papier de l'autocollant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove blue Pod needle cap and check cannula. Then remove paper backing."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove blue Pod needle cap and check cannula. Then remove paper backing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi il cappuccio blu dell'ago del Pod e controlla la cannula. Quindi rimuovi il supporto di carta."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern den blå nålehetten og sjekk at kanylen ikke stikker ut. Fjern deretter plasterbeskyttelsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder de blauwe Podnaalddop en controleer de canule. Verwijder vervolgens de beschermlaag van de hechtstrip."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń niebieską osłonę igły i sprawdź kaniulę. Następnie usuń papierowe zabezpieczenie kleju."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove blue Pod needle cap and check cannula. Then remove paper backing."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remove blue Pod needle cap and check cannula. Then remove paper backing."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отломите защитную крышку канюли (голубого цвета) и проверьте состояние самой канюли. Далее снимите защитные стикеры с пластыря."
          }
        },
        "sk" : {
          "stringUnit" : {
